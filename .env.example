OPENAI_API_KEY=
MESHY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Local development callback example:
# http://127.0.0.1:4183/api/connectors/google/callback
GOOGLE_REDIRECT_URI=
# Offline reminders (Web Push). Optional: generated into server/data/vapid.json
# on first run if empty. Keep the same keys forever, or existing
# subscriptions stop working. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
