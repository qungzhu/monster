ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
CLAUDE_MODEL=
MESHY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Local development callback example:
# http://127.0.0.1:4183/api/connectors/google/callback
GOOGLE_REDIRECT_URI=
# Offline reminders (Web Push). Optional: generated into server/data/vapid.json
# on first run if empty. Keep the same keys forever, or existing
# subscriptions stop working. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Production guards (see server/guard.js and README "上线部署时的防护")
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=
# When set, AI/Meshy endpoints require X-App-Token; build the app with the
# same value in VITE_APP_TOKEN
APP_TOKEN=
VITE_APP_TOKEN=
AI_RATE_LIMIT_PER_MIN=
AI_RATE_LIMIT_PER_DAY=
MESHY_RATE_LIMIT_PER_HOUR=
SAVE_RATE_LIMIT_PER_MIN=
# Where cloud saves live (default server/data/saves)
SAVES_DIR=
