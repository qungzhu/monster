{
  "name": "furry-pal",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/assemble-rigged-fox.mjs",
    "dev": "vite",
    "server": "node server/index.js",
    "meshy:red-fox": "node scripts/generate-red-fox.mjs",
    "rig:red-fox": "node scripts/rig-animate-red-fox.mjs",
    "manifest:gallery": "node scripts/build-gallery-manifest.mjs",
    "upload:gallery": "node scripts/upload-gallery-to-r2.mjs",
    "dev:all": "node server/index.js & node server/plaza.js & vite",
    "prebuild": "node scripts/assemble-rigged-fox.mjs",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "build:sites": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "plaza": "node server/plaza.js",
    "test:plaza": "node server/tests/plaza-room-test.mjs && node server/tests/plaza-bond-test.mjs",
    "test:memory": "node --experimental-strip-types --no-warnings --import ./server/tests/ts-hooks.mjs server/tests/memory-test.mjs",
    "test:agent": "node --experimental-strip-types --no-warnings --import ./server/tests/ts-hooks.mjs server/tests/agent-test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "openai": "^5.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
